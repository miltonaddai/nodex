# Dev: leave unset to use Vite proxy (/api → localhost:3001)
# Production: set to your API base URL, e.g. https://api.yourdomain.com/api
# VITE_API_URL=
VITE_DEMO_MODE=false

# Mirror of backend SUBSCRIPTIONS_ENABLED. Keep the two in sync.
VITE_SUBSCRIPTIONS_ENABLED=false

# true opens the signup form to new accounts; anything else shows "Signups are closed"
VITE_SIGNUPS_ENABLED=false
